{
  "name": "medivara-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MediVara frontend \u2014 patient medical-records, Consultation Brief and ISL Visit Assist (prototype, synthetic data only)",
  "scripts": {
    "predev": "node scripts/fetch-mediapipe.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fetch-mediapipe.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:signs": "node scripts/test-signs.mjs",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "i18n:check": "node scripts/i18n-extract.mjs --check"
  },
  "dependencies": {
    "@elevenlabs/react": "1.15.2",
    "@mediapipe/tasks-vision": "1.0.1",
    "@tanstack/react-query": "^5.59.0",
    "i18next": "26.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.27.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
