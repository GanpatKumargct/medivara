# Copy to .env and fill in. Never commit .env.

# Model provider: openrouter (default) or gemini (Google directly).
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Thinking budget sent as reasoning.effort; empty to omit.
OPENROUTER_REASONING_EFFORT=low

# Only used when LLM_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=
GEMINI_THINKING_LEVEL=low

# live | cache_only | off (failure drills)
AI_MODE=live
DEMO_MODE=true

ASK_CONTEXT_TOKEN_CAP=24000
TIMEOUT_EXTRACT_S=60
TIMEOUT_ASK_S=20
TIMEOUT_NARRATIVE_S=25

SESSION_HOURS=12
POLICY_VERSION=2026-10-demo-1

STORAGE_DIR=storage/files
# PostgreSQL (docker compose up -d at the repo root). Leave empty to use the SQLite file below.
DATABASE_URL=postgresql+psycopg://medivara:medivara_local_dev@127.0.0.1:5433/medivara
DATABASE_PATH=storage/medivara.db
GOLDEN_CACHE_DIR=golden_cache
SAMPLE_MANIFEST=../demo-data/manifest.json
SNAPSHOT_DIR=snapshots

# Development only: answer identical model requests from storage/dev_cache (off on the demo machine)
DEV_RESPONSE_CACHE=false
